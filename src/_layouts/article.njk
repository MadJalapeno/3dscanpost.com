---
layout: default.njk
---
<article class="container mx-auto px-6 py-16 max-w-3xl">
    <nav aria-label="Breadcrumb" class="text-sm opacity-70 mb-6">
        <a class="link link-hover" href="/">Home</a> <span aria-hidden="true">/</span> <span>{{ breadcrumb or title }}</span>
    </nav>
    <div class="prose prose-invert prose-lg max-w-none prose-headings:font-bold prose-a:text-primary">
        {{ content | safe }}
    </div>
    <div class="card bg-base-200 shadow-xl mt-12">
        <div class="card-body items-center text-center">
            <h2 class="card-title text-2xl">Ready to get your part scanned?</h2>
            <p class="opacity-80">Email a few photos from different angles, the approximate dimensions and the material. We'll reply with a quote, usually within 24 hours.</p>
            <div class="card-actions mt-2">
                <a href="/#contact" class="btn btn-primary btn-lg">Get a Quote</a>
                <a href="/#pricing" class="btn btn-outline btn-lg">See Pricing</a>
            </div>
        </div>
    </div>
</article>
