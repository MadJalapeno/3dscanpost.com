---
layout: default.njk
---
<article class="container mx-auto px-6 py-16 max-w-3xl">
    <nav aria-label="Breadcrumb" class="text-sm opacity-70 mb-6">
        <a class="link link-hover" href="/">Home</a> <span aria-hidden="true">/</span> <span>{{ breadcrumb or title }}</span>
    </nav>
    <div id="article-body" class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-base-content prose-p:text-base-content prose-li:text-base-content prose-strong:text-base-content prose-a:text-primary prose-code:text-base-content prose-pre:bg-base-200 prose-pre:text-base-content prose-pre:border prose-pre:border-base-content/15 prose-pre:rounded-box prose-pre:pr-14 prose-pre:shadow-none [&_pre_code]:text-inherit">
        {{ content | safe }}
    </div>
    {% if cta == "download" %}
    <div class="card card-border bg-base-200 mt-12">
        <div class="card-body">
            <h2 class="card-title text-2xl">Free for Windows, macOS and Linux</h2>
            <p class="opacity-80">3D Mesh Tools and 3D Mesh Compare come in one download. No licence fees, no subscriptions.</p>
            <div class="card-actions mt-2">
                <a href="https://github.com/madjalapeno/3dmeshtools/archive/refs/heads/main.zip" class="btn btn-primary btn-lg">Download (zip)</a>
                <a href="/tools/install/" class="btn btn-outline btn-lg">Installation guide</a>
            </div>
        </div>
    </div>
    {% endif %}
    <div class="card card-border bg-base-200 mt-12">
        <div class="card-body items-center text-center">
            <h2 class="card-title text-2xl">Ready to get your part scanned?</h2>
            <p class="opacity-80">Email a few photos from different angles, the approximate dimensions and the material. We'll reply with a quote, usually within 24 hours.</p>
            <div class="card-actions mt-2">
                <a href="/#contact" class="btn btn-primary btn-lg">Get a Quote</a>
                <a href="/#pricing" class="btn btn-outline btn-lg">See Pricing</a>
            </div>
        </div>
    </div>
</article>
<script>
    // Add a copy-to-clipboard button to each code block
    (function () {
        var icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 15V6a2 2 0 012-2h9"/></svg>';
        var done = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
        document.querySelectorAll('#article-body pre').forEach(function (pre) {
            var wrap = document.createElement('div');
            wrap.className = 'relative';
            pre.parentNode.insertBefore(wrap, pre);
            wrap.appendChild(pre);
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-ghost btn-square btn-sm absolute right-2 top-2';
            btn.setAttribute('aria-label', 'Copy to clipboard');
            btn.innerHTML = icon;
            btn.addEventListener('click', function () {
                var text = pre.innerText.replace(/\n$/, '');
                var ok = function () {
                    btn.innerHTML = done;
                    btn.setAttribute('aria-label', 'Copied');
                    setTimeout(function () { btn.innerHTML = icon; btn.setAttribute('aria-label', 'Copy to clipboard'); }, 1500);
                };
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(ok);
                } else {
                    var ta = document.createElement('textarea');
                    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
                    document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); ok(); } catch (e) {}
                    document.body.removeChild(ta);
                }
            });
            wrap.appendChild(btn);
        });
    })();
</script>
