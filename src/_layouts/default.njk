{% include "head.njk" %}

<body class="bg-base-100 text-base-content font-sans">

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:bg-primary focus:text-white focus:p-3">Skip to content</a>

{% include "navigation.njk" %}

<main id="main" class="flex-1 flex flex-col">
{{ content | safe }}
</main>

{% include "footer.njk" %}

<dialog id="shot-modal" class="modal">
  <div class="modal-box w-auto max-w-[95vw] border border-base-content/15 bg-base-100 p-2">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3 z-10 bg-base-100/80" aria-label="Close">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </form>
    <img id="shot-img" alt="" class="h-auto max-h-[80vh] w-auto max-w-full rounded-field object-contain">
    <p id="shot-caption" class="mt-2 text-center font-mono text-xs opacity-80"></p>
  </div>
  <form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
</dialog>
<script>
  (function () {
    var modal = document.getElementById('shot-modal');
    if (!modal) return;
    var img = document.getElementById('shot-img');
    var cap = document.getElementById('shot-caption');
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[data-modal]');
      if (!a) return;
      e.preventDefault();
      img.src = a.href;
      img.alt = a.querySelector('img').alt;
      cap.textContent = a.dataset.caption || '';
      modal.showModal();
    });
  })();
</script>
</body>
</html>
