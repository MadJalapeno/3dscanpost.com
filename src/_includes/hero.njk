    <!-- Hero Section -->
    <div class="hero min-h-screen bg-base-100">
        <div class="hero-content flex-col lg:flex-row-reverse gap-12 max-w-7xl">
            <div class="flex-1 w-full">
                <div class="card bg-base-200 shadow-2xl">
                    <div class="card-body p-2">
                        <div class="relative w-full h-[500px]">
                            <button id="hero-activate" type="button" aria-label="Tap to explore in 3D (loads the interactive model)" class="absolute inset-0 z-10 flex items-end justify-center pb-4 cursor-pointer">
                                <span class="badge badge-primary badge-lg">Tap to explore in 3D</span>
                            </button>
                            <img id="hero-poster" src="/assets/images/battery-poster.webp" width="830" height="1000" alt="" aria-hidden="true" fetchpriority="high" class="absolute inset-0 w-full h-full object-contain pointer-events-none">
                            <model-viewer
                                id="hero-model"
                                src="/assets/scans/battery.glb"
                                alt="3D scan example of a battery"
                                auto-rotate
                                camera-controls
                                shadow-intensity="2"
                                exposure="0.7"
                                shadow-softness="0.8"
                                environment-image="legacy"
                                class="absolute inset-0"
                                style="width: 100%; height: 100%; --poster-color: transparent;"
                                camera-orbit="45deg 75deg 105%"
                                interaction-prompt="auto"
                            ></model-viewer>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <div class="badge badge-primary badge-lg gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                        </svg>
                        Drag to rotate • Scroll to zoom
                    </div>
                </div>
            </div>
            <div class="flex-1 text-center lg:text-left">
                <h1 class="text-5xl md:text-6xl font-bold leading-tight">3D Scanning by Mail</h1>
                <p class="py-6 text-xl opacity-80">Ship it. We scan it. Download your files.</p>
                
                <div class="stats stats-vertical lg:stats-horizontal shadow mb-6">
                    <div class="stat">
                        <div class="stat-title">Accuracy</div>
                        <div class="stat-value text-primary text-2xl">±0.2mm</div>
                        <div class="stat-desc">Laser scanning</div>
                    </div>
                    <div class="stat">
                        <div class="stat-title">Turnaround</div>
                        <div class="stat-value text-secondary text-2xl">2-3 days</div>
                        <div class="stat-desc">24hr available</div>
                    </div>
                    <div class="stat">
                        <div class="stat-title">Starting at</div>
                        <div class="stat-value text-accent text-2xl">$55</div>
                        <div class="stat-desc">Simple parts</div>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#contact" class="btn btn-primary btn-lg">Get Started</a>
                    <a href="#scan-types" class="btn btn-outline btn-lg">View Scan Options</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // model-viewer (WebGL + Draco decoding) is heavy on the main thread, so only
        // load it once the visitor engages. The poster image covers the wait.
        (function () {
            var model = document.getElementById('hero-model');
            var started = false;
            var events = ['pointerdown', 'touchstart', 'keydown', 'mousemove', 'scroll'];

            function removePoster() {
                ['hero-poster', 'hero-activate'].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.remove();
                });
            }

            function loadViewer() {
                if (started) return;
                started = true;
                events.forEach(function (e) { window.removeEventListener(e, loadViewer); });
                var s = document.createElement('script');
                s.type = 'module';
                s.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js';
                document.head.appendChild(s);
            }

            model.addEventListener('load', removePoster);
            document.getElementById('hero-activate').addEventListener('click', loadViewer);
            events.forEach(function (e) { window.addEventListener(e, loadViewer, { passive: true }); });
        })();
    </script>
