{%- set businessGraph = [
  {
    "@type": "WebSite",
    "@id": site.url + "/#website",
    "url": site.url + "/",
    "name": site.name,
    "description": site.description,
    "inLanguage": "en-US",
    "publisher": { "@id": site.url + "/#business" }
  },
  {
    "@type": "ProfessionalService",
    "@id": site.url + "/#business",
    "name": site.name,
    "url": site.url + "/",
    "description": site.description,
    "logo": site.logo,
    "image": site.ogImage,
    "email": "contact@3dscanpost.com",
    "priceRange": "$$",
    "foundingDate": "2025",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "NH",
      "addressCountry": "US"
    },
    "areaServed": "Worldwide",
    "knowsAbout": ["3D scanning", "Laser 3D scanning", "Infrared 3D scanning", "Reverse engineering", "STL files", "PLY files"],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "contact@3dscanpost.com",
      "areaServed": "Worldwide",
      "availableLanguage": "en"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "3D scanning services",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Standard 3D scanning (2-3 day turnaround)",
          "description": "Mail-in 3D scan of your part with STL and PLY files delivered. Laser scanning with ±0.2mm accuracy, or infrared scanning with full color texture.",
          "priceSpecification": { "@type": "PriceSpecification", "minPrice": 55, "priceCurrency": "USD" },
          "itemOffered": { "@type": "Service", "name": "Mail-in 3D scanning", "serviceType": "3D scanning" }
        },
        {
          "@type": "Offer",
          "name": "Express 3D scanning (24-hour turnaround)",
          "description": "Priority 24-hour turnaround for a 30% premium over standard pricing.",
          "itemOffered": { "@type": "Service", "name": "Express mail-in 3D scanning", "serviceType": "3D scanning" }
        }
      ]
    }
  }
] -%}

{%- if page.url == '/' -%}
  {%- set faqEntities = [] -%}
  {%- for faq in faqs -%}
    {%- set faqEntities = (faqEntities.push({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }), faqEntities) -%}
  {%- endfor -%}
  {%- set businessGraph = (businessGraph.push({
    "@type": "FAQPage",
    "@id": site.url + "/#faq",
    "mainEntity": faqEntities
  }), businessGraph) -%}
{%- else -%}
  {%- set businessGraph = (businessGraph.push({
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
      { "@type": "ListItem", "position": 2, "name": breadcrumb or title, "item": pageUrl }
    ]
  }), businessGraph) -%}
{%- endif -%}

<!-- JSON-LD Structured Data -->
<script type="application/ld+json">
{{ { "@context": "https://schema.org", "@graph": businessGraph } | dump | safe }}
</script>
