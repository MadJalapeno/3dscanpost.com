{%- set businessGraph = [
  {
    "@type": "WebSite",
    "@id": site.url + "/#website",
    "url": site.url + "/",
    "name": site.name,
    "description": site.description,
    "inLanguage": "en-US",
    "publisher": { "@id": site.url + "/#business" }
  },
  {
    "@type": "ProfessionalService",
    "@id": site.url + "/#business",
    "name": site.name,
    "url": site.url + "/",
    "description": site.description,
    "logo": site.logo,
    "image": site.ogImage,
    "email": "contact@3dscanpost.com",
    "priceRange": "$$",
    "foundingDate": "2025",
    "parentOrganization": { "@id": "https://jalapeno.design/#organization" },
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "NH",
      "addressCountry": "US"
    },
    "areaServed": "Worldwide",
    "knowsAbout": ["3D scanning", "Laser 3D scanning", "Infrared 3D scanning", "Reverse engineering", "STL files", "PLY files", "STEP files"],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "contact@3dscanpost.com",
      "areaServed": "Worldwide",
      "availableLanguage": "en"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "3D scanning services",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Standard 3D scanning (2-3 day turnaround)",
          "description": "Mail-in 3D scan of your part with an STL file delivered (PLY available for color). Laser scanning with ±0.2mm accuracy, or infrared scanning with full color texture.",
          "priceSpecification": { "@type": "PriceSpecification", "minPrice": 55, "priceCurrency": "USD" },
          "itemOffered": { "@type": "Service", "name": "Mail-in 3D scanning", "serviceType": "3D scanning" }
        },
        {
          "@type": "Offer",
          "name": "CAD conversion (SolidWorks model and STEP file)",
          "description": "Optional rebuild of a scanned part as a parametric SolidWorks model with a STEP file, measured against the physical part.",
          "priceSpecification": { "@type": "PriceSpecification", "minPrice": 55, "priceCurrency": "USD" },
          "itemOffered": { "@type": "Service", "name": "CAD conversion from 3D scan", "serviceType": "Reverse engineering" }
        },
        {
          "@type": "Offer",
          "name": "Express 3D scanning (24-hour turnaround)",
          "description": "Priority 24-hour turnaround for a 30% premium over standard pricing.",
          "itemOffered": { "@type": "Service", "name": "Express mail-in 3D scanning", "serviceType": "3D scanning" }
        }
      ]
    }
  }
] -%}

{%- if page.url == '/' -%}
  {%- set faqEntities = [] -%}
  {%- for faq in faqs -%}
    {%- set faqEntities = (faqEntities.push({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }), faqEntities) -%}
  {%- endfor -%}
  {%- set businessGraph = (businessGraph.push({
    "@type": "FAQPage",
    "@id": site.url + "/#faq",
    "mainEntity": faqEntities
  }), businessGraph) -%}
{%- else -%}
  {%- set crumbs = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" }] -%}
  {%- if parent -%}
    {%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": 2, "name": parent.name, "item": site.url + parent.url }), crumbs) -%}
  {%- endif -%}
  {%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": breadcrumb or title, "item": pageUrl }), crumbs) -%}
  {%- set businessGraph = (businessGraph.push({ "@type": "BreadcrumbList", "itemListElement": crumbs }), businessGraph) -%}

  {%- set modified = page.inputPath | lastmod -%}
  {%- if schema == "article" -%}
    {%- set article = {
      "@type": "Article",
      "@id": pageUrl + "#article",
      "headline": title | replace(" | 3DScanPost", ""),
      "description": description,
      "image": (site.url + ogImage) if ogImage else site.ogImage,
      "mainEntityOfPage": pageUrl,
      "inLanguage": "en-US",
      "dateModified": modified or undefined,
      "author": { "@id": site.url + "/#business" },
      "publisher": { "@id": site.url + "/#business" }
    } -%}
    {%- set businessGraph = (businessGraph.push(article), businessGraph) -%}
  {%- elif schema == "software" -%}
    {%- set software = {
      "@type": "SoftwareApplication",
      "@id": pageUrl + "#software",
      "name": breadcrumb,
      "description": description,
      "url": pageUrl,
      "applicationCategory": "DesignApplication",
      "operatingSystem": "Windows, macOS, Linux",
      "downloadUrl": "https://github.com/madjalapeno/3dmeshtools/archive/refs/heads/main.zip",
      "image": (site.url + ogImage) if ogImage else site.ogImage,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@id": site.url + "/#business" }
    } -%}
    {%- set businessGraph = (businessGraph.push(software), businessGraph) -%}
  {%- endif -%}
{%- endif -%}

<!-- JSON-LD Structured Data -->
<script type="application/ld+json">
{{ { "@context": "https://schema.org", "@graph": businessGraph } | dump | safe }}
</script>
