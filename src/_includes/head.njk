{%- set pageDescription = description or site.description -%}
{%- set pageOgImage = (site.url + ogImage) if ogImage else site.ogImage -%}
{%- set pageOgAlt = ogImageAlt or "3DScanPost - 3D scanning by mail. STL and PLY files, from $55." -%}
{%- set pageUrl = site.url + (page.url if page.url != '/' else '/') -%}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth scroll-pt-20">
<head>
    <!--
    debugging info
    =============================
      site.name:    {{ site.name }}
      site.url:     {{ site.url }}
      title:        {{ title }}
      build:        {{ buildInfo.hash }}
      built:        {{ buildInfo.date }}
      commit date:  {{ buildInfo.commitDate }}
    ==============================
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- if threeImportMap %}
    <!-- Import maps only apply if they precede every module script, including the dev server's reload client -->
    <script type="importmap">{"imports":{"three":"/assets/vendor/three-0.160.0/build/three.module.min.js"}}</script>
{%- endif %}
    <title>{{ title }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta name="author" content="{{ site.name }}">
{% if noindex %}
    <meta name="robots" content="noindex, nofollow">
{% else %}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{% endif %}

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ pageUrl }}">

    <!-- OpenGraph Tags -->
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="{{ pageOgImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ pageOgAlt }}">

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageOgImage }}">
    <meta name="twitter:image:alt" content="{{ pageOgAlt }}">

    <!-- Favicon and Manifest -->
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg?v={% version %}">
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png?v={% version %}">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0c1812">
    <script>
        // Set the theme before first paint to avoid a flash: saved choice, else the OS preference
        (function () {
            var t;
            try { t = localStorage.getItem('theme'); } catch (e) {}
            if (t !== 'light' && t !== 'dark') {
                t = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            }
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    {% if env.environment != "dev" %}
    <!-- Preconnect to external resources -->      
    <link rel="preconnect" href="https://stats.jala.dev">
    {% endif %}

    <link rel="preload" href="/assets/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/css/tailwind.css?v={% version %}" />

{% if not noindex %}
{% include "structured-data.njk" %}
{% endif %}

  <!-- analytics -->
{% if env.environment == "dev" %}
  <!-- this is dev mode -->
{% else %}
  <script
    src="https://stats.jala.dev/api/script.js?siteId=7e792edf4cc5"
    defer
></script>
{% endif %}

</head>
