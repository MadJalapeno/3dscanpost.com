    <!-- FAQ -->
    <section id="faq" class="mx-auto max-w-6xl px-6 py-20">
        <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl after:mt-3 after:block after:h-0.5 after:w-12 after:bg-primary after:content-[''] mb-12">Frequently Asked Questions</h2>
        <div class="max-w-3xl space-y-4">
{% for faq in faqs %}
            <div class="collapse collapse-plus border border-base-300 bg-base-100">
                <input type="radio" name="faq-accordion" aria-label="{{ faq.q }}" />
                <div class="collapse-title text-xl font-medium">{{ faq.q }}</div>
                <div class="collapse-content">
                    <p>{{ faq.a }}</p>
{%- if faq.link %}
                    <p class="mt-2"><a class="link link-primary" href="{{ faq.link.href }}" rel="noopener">{{ faq.link.text }}</a></p>
{%- endif %}
                </div>
            </div>
{% endfor %}
        </div>
    </section>
