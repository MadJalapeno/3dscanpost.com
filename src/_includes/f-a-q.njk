    <!-- FAQ -->
    <section id="faq" class="container mx-auto px-6 py-20">
        <h2 class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
        <div class="max-w-3xl mx-auto space-y-4">
{% for faq in faqs %}
            <div class="collapse collapse-plus bg-base-200">
                <input type="radio" name="faq-accordion" aria-label="{{ faq.q }}" />
                <div class="collapse-title text-xl font-medium">{{ faq.q }}</div>
                <div class="collapse-content">
                    <p>{{ faq.a }}</p>
{%- if faq.link %}
                    <p class="mt-2"><a class="link link-primary" href="{{ faq.link.href }}" rel="noopener">{{ faq.link.text }}</a></p>
{%- endif %}
                </div>
            </div>
{% endfor %}
        </div>
    </section>
