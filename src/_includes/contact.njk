<!-- Contact -->
    <section id="contact" class="border-t border-base-content/10 bg-base-200 py-20">
        <div class="mx-auto max-w-6xl px-6">
            <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl after:mt-3 after:block after:h-0.5 after:w-12 after:bg-primary after:content-[''] mb-4">Ready to Get Started?</h2>
            <p class="mb-12 max-w-2xl opacity-70">Got a part you want scanned? Send some photos and we'll get back to you within 24 hours.</p>

            <div class="grid gap-12 lg:grid-cols-5">
                <!-- Left: what to send, alternative contact -->
                <div class="space-y-8 lg:col-span-2">
                    <div>
                        <h3 class="mb-3 font-mono text-xs font-semibold uppercase tracking-widest text-primary">What to include</h3>
                        <ul class="space-y-3">
                            {%- for item in ["Photos of your part from all angles", "Approximate dimensions", "Material type, if known", "Standard or express turnaround", "Any special concerns or requirements"] %}
                            <li class="flex gap-3"><svg class="mt-1 size-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><span>{{ item }}</span></li>
                            {%- endfor %}
                        </ul>
                    </div>
                </div>

                <!-- Right: email -->
                <div class="card card-border bg-base-100 lg:col-span-3">
                    <div class="card-body justify-center">
                        <h3 class="card-title font-display text-2xl">Request a quote</h3>
                        <p class="opacity-80">Tell us about your part and attach photos. We'll reply with a quote, usually within 24 hours.</p>
                        <div class="mt-2">
                            <a href="/quote/" class="btn btn-primary btn-lg w-full sm:w-auto">Request a quote</a>
                        </div>
                        <div class="divider">Or email us</div>
                        <div>
{% include "email.njk" %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Service disclaimer -->
            <div class="mt-16 border-t border-base-content/10 pt-10">
                <h3 class="mb-6 font-mono text-xs font-semibold uppercase tracking-widest text-primary">Service disclaimer</h3>
                <div class="grid gap-x-10 gap-y-6 text-sm md:grid-cols-2">
                    <div>
                        <h4 class="mb-2 font-semibold">Accuracy &amp; Quality</h4>
                        <p class="opacity-80">All 3D scans are provided on a best-effort basis. While we use the latest equipment and techniques, we do not guarantee the accuracy, completeness, or fitness of scans for any particular purpose. Scan quality may vary based on subject geometry, material properties, surface conditions, and environmental factors. You are responsible for verifying scan accuracy before relying on scans for critical applications (manufacturing, medical, etc.).</p>
                    </div>
                    <div>
                        <h4 class="mb-2 font-semibold">No Liability</h4>
                        <p class="opacity-80">We are not liable for any direct, indirect, incidental, or consequential damages arising from scan quality, accuracy, data loss, or inability to use scans as intended—including manufacturing errors, financial loss, or project delays.</p>
                    </div>
                    <div>
                        <h4 class="mb-2 font-semibold">Intellectual Property &amp; Copyright</h4>
                        <p class="opacity-80">You are solely responsible for ensuring you have the legal right to have items scanned. We do not verify ownership or copyright status. You agree not to hold us liable for scanning items containing copyrighted, trademarked, or proprietary material, or material belonging to third parties. You indemnify us against any claims arising from the content scanned or use of scans.</p>
                    </div>
                    <div>
                        <h4 class="mb-2 font-semibold">Data Use</h4>
                        <p class="opacity-80">Scans may be used internally for process improvement, portfolio examples (anonymized), or troubleshooting unless otherwise agreed in writing.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
