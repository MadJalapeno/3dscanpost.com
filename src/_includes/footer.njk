    <script>
        // Light/dark toggle
        (function () {
            var btn = document.getElementById('theme-toggle');
            var root = document.documentElement;
            function sync() {
                var dark = root.getAttribute('data-theme') === 'dark';
                btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
                btn.querySelector('.theme-icon-sun').style.display = dark ? '' : 'none';
                btn.querySelector('.theme-icon-moon').style.display = dark ? 'none' : '';
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', dark ? '#0c1812' : '#fbfdf9');
            }
            btn.addEventListener('click', function () {
                var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-theme', next);
                try { localStorage.setItem('theme', next); } catch (e) {}
                sync();
            });
            sync();
        })();

        // Close the nav's <details> dropdowns on outside click, Escape, or choosing a link
        (function () {
            var menus = document.querySelectorAll('header details');
            function closeAll(except) {
                menus.forEach(function (d) { if (d !== except) d.removeAttribute('open'); });
            }
            document.addEventListener('click', function (e) {
                var inside = e.target.closest('header details');
                closeAll(inside);
                if (inside && e.target.closest('details ul a')) inside.removeAttribute('open');
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeAll(null);
            });
        })();

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    const offset = 80;
                    const targetPosition = target.offsetTop - offset;
                    window.scrollTo({
                        top: targetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
